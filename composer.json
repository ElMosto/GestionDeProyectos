{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "elmosto/gestion-estudio",
  "description": "Sistema de gestión para estudio musical: proyectos, clientes, ventas, reservas y finanzas.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-bcmath": "*",
    "ext-ctype": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-session": "*",
    "ext-simplexml": "*",
    "ext-xml": "*",
    "ext-xmlreader": "*",
    "ext-xmlwriter": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "phpoffice/phpspreadsheet": "^5.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform-check": true,
    "allow-plugins": false
  },
  "scripts": {
    "test": "phpunit",
    "check-platform": "composer check-platform-reqs"
  },
  "scripts-descriptions": {
    "test": "Ejecuta la suite de PHPUnit.",
    "check-platform": "Verifica extensiones y versión de PHP requeridas."
  }
}
