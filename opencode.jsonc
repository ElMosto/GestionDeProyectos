{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "config/config.php", "effect": "ask" },
    { "action": "read", "resource": "storage/private/**", "effect": "ask" },
    { "action": "edit", "resource": "vendor/**", "effect": "deny" },
    { "action": "edit", "resource": ".git/**", "effect": "deny" },
    { "action": "edit", "resource": "storage/**", "effect": "deny" }
  ]
}
